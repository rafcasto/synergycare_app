rules_version = '2';

// Everything is written and read through the server (Admin SDK), which
// bypasses these rules. Client SDKs get nothing:
//
//   eoi_leads     — registrations, including names, emails and phone numbers
//   site_content  — landing page copy, editable only from /admin
//   media         — uploaded image bytes, served via /api/media/[slug]
//
// The browser only ever loads Firebase Analytics and Auth, never Firestore,
// so a total lockdown costs nothing and keeps the lead list private.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
